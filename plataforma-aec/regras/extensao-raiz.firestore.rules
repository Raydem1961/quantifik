    // ── Funções auxiliares dos módulos novos (perfis mais finos que os do ObraTop 3) ──
    // O perfil (coordenador, orcamentista ou projetista) fica em organizations/{org}/perfis/{uid},
    // que só o proprietário grava — o próprio usuário não consegue se promover.
    // O proprietário (role == 'owner') pode tudo, como sempre.
    function perfilDe(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/perfis/$(request.auth.uid))
        ? get(/databases/$(database)/documents/organizations/$(orgId)/perfis/$(request.auth.uid)).data.get('perfil', '')
        : '';
    }
    // Sem perfil próprio, o Gestor do ObraTop atua como coordenador e o Financeiro como orçamentista; Consulta nunca grava.
    function gestorAec(orgId) { return owner(orgId) || (member(orgId) && memberDoc(orgId).get('role', '') != 'viewer' && (perfilDe(orgId) == 'coordenador' || (perfilDe(orgId) == '' && memberDoc(orgId).get('role', '') == 'manager'))); }
    function orcaAec(orgId) { return gestorAec(orgId) || (member(orgId) && memberDoc(orgId).get('role', '') != 'viewer' && (perfilDe(orgId) == 'orcamentista' || (perfilDe(orgId) == '' && memberDoc(orgId).get('role', '') == 'finance'))); }
    // Convites com funções do ObraTop 3 (somados ao convite de engenheiro da obra). Gestor, Financeiro
    // e Consulta enxergam todas as obras, então o convite não leva obra.
    match /invites/{code} {
      allow create: if signedIn() && owner(request.resource.data.orgId)
        && request.resource.data.role in ['manager', 'finance', 'viewer']
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.workId is string
        // Sem obra: nas regras do ObraTop, quem tem obra atribuída pode gravar nela — Consulta não pode.
        && request.resource.data.workId == ''
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time;
    }
    function naoAltera(campos) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }

    // CUB oficial: leitura para qualquer usuário autenticado; escrita só pelo script de importação.
    match /cubTables/{tabelaId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Índice interno documento-de-assinatura → contrato (somente backend).
    match /signatureRequests/{id} { allow read, write: if false; }

    // Consultas que atravessam projetos (ART/RRT e horas de toda a empresa).
    match /{path=**}/artRrt/{id} {
      allow read: if resource.data.orgId is string && member(resource.data.orgId);
    }
    match /{path=**}/timesheets/{id} {
      allow read: if resource.data.orgId is string && gestorAec(resource.data.orgId);
    }

    // ── Portal do Cliente ──
    // Um documento por obra (id = {org}_{obra}) com o retrato do contrato. Só o proprietário grava.
    // O cliente NÃO é membro da empresa: lê apenas os painéis em que seu e-mail (confirmado) está listado.
    function clienteDoPortal(dados) {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in dados.emails;
    }
    match /portalCliente/{portalId} {
      allow read: if clienteDoPortal(resource.data) || owner(resource.data.orgId);
      allow create, update: if owner(request.resource.data.orgId)
        && portalId == request.resource.data.orgId + '_' + request.resource.data.workId
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 10
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/works/$(request.resource.data.workId));
      allow delete: if owner(resource.data.orgId);
    }
    // Relatório fotográfico do portal: um documento por mês. O cliente lê se o painel-pai o lista.
    match /portalCliente/{portalId}/fotos/{mes} {
      allow read: if clienteDoPortal(get(/databases/$(database)/documents/portalCliente/$(portalId)).data)
        || owner(get(/databases/$(database)/documents/portalCliente/$(portalId)).data.orgId);
      allow create, update: if owner(request.resource.data.orgId)
        && portalId == request.resource.data.orgId + '_' + request.resource.data.workId
        && request.resource.data.mes == mes && request.resource.data.dias is list;
      allow delete: if owner(resource.data.orgId);
    }

    // ── Licenças: criar empresa só com código emitido pelo administrador da plataforma ──
    // O administrador da plataforma é definido pelo instalador em plataforma/acesso (ninguém grava
    // esse documento pelo aplicativo). Cada código vale para UMA empresa e, se emitido para um
    // e-mail, só para esse e-mail confirmado.
    function plataformaAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/plataforma/acesso) && (
        request.auth.uid in get(/databases/$(database)/documents/plataforma/acesso).data.get('admins', []) ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') in get(/databases/$(database)/documents/plataforma/acesso).data.get('emails', [])));
    }
    function licencaParaEmpresa(orgId) {
      let codigo = request.resource.data.get('licenca', '');
      return plataformaAdmin() || (codigo is string && codigo.size() >= 12 &&
        getAfter(/databases/$(database)/documents/licencas/$(codigo)).data.get('orgId', '') == orgId &&
        getAfter(/databases/$(database)/documents/licencas/$(codigo)).data.get('usadaPor', '') == request.auth.uid);
    }
    match /plataforma/{docId} {
      allow read: if plataformaAdmin();
      allow write: if false;
    }
    match /licencas/{codigo} {
      allow list: if plataformaAdmin();
      allow get: if plataformaAdmin() || (signedIn() && resource.data.get('usada', false) == false);
      allow create: if plataformaAdmin() && codigo.size() >= 12 && request.resource.data.usada == false &&
        request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
        request.resource.data.cliente is string && request.resource.data.cliente.size() <= 160 &&
        request.resource.data.expiraEm is timestamp && request.resource.data.expiraEm > request.time &&
        request.resource.data.keys().hasOnly(['usada', 'email', 'cliente', 'expiraEm', 'criadaEm', 'criadaPor', 'observacao']);
      allow delete: if plataformaAdmin() && resource.data.usada == false;
      // Uso do código: só pela própria pessoa, uma vez, dentro do prazo, junto com a criação da empresa.
      allow update: if signedIn() && resource.data.usada == false && request.time < resource.data.expiraEm &&
        (resource.data.email == '' || (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') == resource.data.email)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usada', 'orgId', 'usadaPor', 'usadaEm', 'usadaEmail']) &&
        request.resource.data.usada == true && request.resource.data.usadaPor == request.auth.uid &&
        request.resource.data.orgId is string &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.get('ownerUid', '') == request.auth.uid &&
        getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.get('licenca', '') == codigo &&
        !exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId));
    }

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(orgId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function owner(orgId) {
      return member(orgId) && firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'owner';
    }
    function assigned(orgId, workId) {
      return member(orgId) &&
        firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.workId == workId;
    }
    function safeFile() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('(application/pdf|image/.*|application/msword|application/vnd.*)');
    }

    match /organizations/{orgId}/documents/{workId}/{fileName} {
      allow read: if member(orgId);
      allow create: if (owner(orgId) || assigned(orgId, workId)) && safeFile();
      allow update: if false;
      allow delete: if owner(orgId);
    }

    // Compatibilidade somente-leitura/remoção para anexos antigos da produção.
    match /organizations/{orgId}/documents/{fileName} {
      allow read: if member(orgId);
      allow create, update: if false;
      allow delete: if owner(orgId);
    }
    // >>> EXTENSÃO ObraTop 4 (gerada — não edite aqui)
    // Gestor do ObraTop (todas as obras): envia anexos de documentos e fotos do diário.
    function gestorStorage(orgId) {
      return member(orgId) && firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') == 'manager';
    }
    match /organizations/{orgId}/documents/{workId}/{fileName} {
      allow create: if gestorStorage(orgId) && safeFile();
    }
    // CAD: organizations/{org}/projects/{p}/cad/{disciplina}/{carimbo}__{arquivo}
    // Objetos são imutáveis (cada upload é uma nova revisão) — por isso não há `update`.
    match /organizations/{orgId}/projects/{projectId}/cad/{disciplina}/{arquivo} {
      allow read: if member(orgId);
      allow create: if member(orgId)
        && request.resource.metadata.uid == request.auth.uid // autoria não pode ser forjada
        && request.resource.size < 300 * 1024 * 1024
        && arquivo.matches('(?i).*\\.(dwg|dxf|csv|xml|ifc|inp|txt|landxml)$');
      allow delete: if owner(orgId);
    }
    // PDFs de propostas e contratos.
    match /organizations/{orgId}/projects/{projectId}/docs/{arquivo} {
      allow read: if member(orgId);
      allow create: if member(orgId) && request.resource.contentType == 'application/pdf' && request.resource.size < 30 * 1024 * 1024;
    }
    // Logotipo (white-label).
    match /organizations/{orgId}/branding/{arquivo} {
      allow read: if member(orgId);
      allow write: if owner(orgId) && request.resource.contentType.matches('image/.*') && request.resource.size < 2 * 1024 * 1024;
    }
    // Fotos do Diário de Obra (JPG já comprimido no aparelho). Quem grava na obra envia e remove.
    match /organizations/{orgId}/diario/{workId}/{logId}/{arquivo} {
      allow read: if member(orgId);
      allow create: if (owner(orgId) || assigned(orgId, workId) || gestorStorage(orgId))
        && request.resource.contentType == 'image/jpeg' && request.resource.size < 6 * 1024 * 1024
        && request.resource.metadata.uid == request.auth.uid;
      allow update: if false;
      allow delete: if owner(orgId) || assigned(orgId, workId) || gestorStorage(orgId);
    }
    // <<< EXTENSÃO ObraTop 4
  }
}
